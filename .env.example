# VIF SmartShelf — Environment Variables Template
# Copy this to .env and fill in real values.
# NEVER commit .env to git.

# ================================================================
# Application
# ================================================================

APP_ENV=development
# Options: development | production
# In production, debug mode is disabled, stricter CORS is applied.

LOG_LEVEL=INFO
# Options: DEBUG | INFO | WARNING | ERROR

# ================================================================
# Inference API
# ================================================================

API_HOST=0.0.0.0
API_PORT=8000

# Upload limits
MAX_UPLOAD_SIZE_MB=10
# Maximum image file size in megabytes. Reject anything larger.

# Model inference settings
INFERENCE_CONFIDENCE_THRESHOLD=0.25
# Minimum confidence score (0.0–1.0) to include a detection in the response.
# Detections below this threshold are silently dropped.
# Increase to reduce false positives; decrease to catch more objects at lower confidence.

INFERENCE_IOU_THRESHOLD=0.45
# IoU threshold for Non-Maximum Suppression (NMS).
# Controls how aggressively overlapping boxes are suppressed.

# ================================================================
# Model Artifact
# ================================================================

# Local path where the model file is expected.
# The API validates this file exists and its checksum matches MODEL_SHA256
# before accepting requests.
MODEL_ARTIFACT_PATH=/app/models/smartshelf/best.pt

MODEL_VERSION=v0.1.0
# Must match the version directory in Hugging Face Hub or R2.

MODEL_SHA256=
# SHA256 checksum of best.pt. Set after the model is released.
# Example: a3f8bc2d91e4f6720c5a8b3d0e1f9a2c...
# Leave empty in development if checksum verification is disabled.

# Hugging Face Hub (optional — for downloading model at startup)
HF_MODEL_REPO=
# Example: your-org/smartshelf-models
# Leave empty if model is loaded from MODEL_ARTIFACT_PATH directly.

HF_TOKEN=
# Required only if the Hugging Face model repo is private.
# DO NOT commit this value.

# ================================================================
# Database
# ================================================================

DATABASE_URL=postgresql+asyncpg://smartshelf:smartshelf@localhost:5432/smartshelf
# Format: postgresql+asyncpg://user:password@host:port/dbname
# For Neon: postgresql+asyncpg://user:pass@ep-xxx.region.aws.neon.tech/smartshelf?sslmode=require

# ================================================================
# CORS
# ================================================================

CORS_ALLOWED_ORIGINS=http://localhost:3000
# Comma-separated list of allowed frontend origins.
# Production example: https://smartshelf.yourdomain.com
# DO NOT use * in production.

# ================================================================
# Rate Limiting
# ================================================================

RATE_LIMIT_PER_MINUTE=10
# Maximum API requests per minute per IP address.
# Applies to inference endpoints only (not health checks).

# ================================================================
# Frontend (apps/web/.env.local)
# These variables are used by the Next.js app, not the API.
# Copy the relevant ones to apps/web/.env.local
# ================================================================

# Server-side only (not exposed to browser)
INFERENCE_API_URL=http://localhost:8000
# The URL of the FastAPI inference service.
# In production: https://api.smartshelf.yourdomain.com

# Public (safe to expose to browser)
NEXT_PUBLIC_DEMO_MODE=true
# Set to true to start in demo mode (uses sample data, no API calls).
# Set to false in production to use real inference.

NEXT_PUBLIC_APP_VERSION=0.1.0-dev
# Displayed in the Settings page and footer.
